{
  "$schema": "https://json.schemastore.org/nest-cli",
  "collection": "@nestjs/schematics",
  "sourceRoot": "apps/quwat/src",
  "compilerOptions": {
    "deleteOutDir": true,
    "webpack": true,
    "tsConfigPath": "apps/quwat/tsconfig.app.json"
  },
  "monorepo": true,
  "root": "apps/quwat",
  "projects": {
    "quwat": {
      "type": "application",
      "root": "apps/quwat",
      "entryFile": "main",
      "sourceRoot": "apps/quwat/src",
      "compilerOptions": {
        "tsConfigPath": "apps/quwat/tsconfig.app.json"
      }
    },
    "quwat-batch": {
      "type": "application",
      "root": "apps/quwat-batch",
      "entryFile": "main",
      "sourceRoot": "apps/quwat-batch/src",
      "compilerOptions": {
        "tsConfigPath": "apps/quwat-batch/tsconfig.app.json"
      }
    }
  }
}